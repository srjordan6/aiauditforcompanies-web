---
// Analytics + consent for the marketing site.
//
// This component is now a thin loader. All tag IDs, the consent state
// machine, Consent Mode v2 defaults, the intent-event listener and the
// banner live in ONE place: public/srj-analytics.js.
//
// That file is also what the three raw HTML pages under public/ (terms,
// privacy, disclaimer) load, via a single <script src> tag. Previously each
// of those carried its own inline copy of every snippet, and this component
// carried a comment warning that changing an ID meant remembering to edit
// three other files. That failure mode is now structurally impossible.
//
// What this component still does: pass build-time `pillar` and `section`
// values, derived from the page path, as data attributes. The script falls
// back to deriving the same values from location.pathname when they are
// absent — which is how the raw public/ pages, with no build step, get
// correct dimensions too.
//
// is:inline is required — without it Astro bundles and rewrites the script
// reference, and third-party tags break.

const path = Astro.url.pathname;
const segments = path.split('/').filter(Boolean);
const pillar = segments.length ? segments[0] : 'home';
const section = segments.length >= 2 ? segments.slice(0, 2).join('/') : pillar;
---

<script is:inline src="/srj-analytics.js" data-pillar={pillar} data-section={section}></script>
